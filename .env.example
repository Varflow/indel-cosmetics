# Попадает в каждый <loc> в sitemap.xml и в robots.txt.
# На продакшен-сборке обязательно боевой домен по https, иначе Google Search
# Console отклонит карту: все URL должны быть на том же хосте, что и сама карта.
# Прод: NUXT_PUBLIC_SITE_URL=https://indelcosm.com.ua
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# База Strapi вместе с префиксом развёртывания (без /api на конце).
# ОБЯЗАТЕЛЬНО доступен в рантайме: пререндера здесь нет, карта собирается
# запросом к /api/_sitemap-urls на каждый запрос к /sitemap_index.xml (с
# внутренним кэшем модуля). Если Strapi недоступен, карта отдаст 200 только со
# статическими страницами — без товаров, новостей, категорий и подкатегорий.
# Прод: STRAPI_URL=https://indelcosm.com.ua/dashboard
STRAPI_URL=http://localhost:1337
